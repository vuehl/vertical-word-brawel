{
  "name": "pokebonk-wechat-portrait",
  "version": "0.8.34-portrait.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:dev": "node tools/build.mjs --dev",
    "preview": "node tools/preview.mjs",
    "preview:dev": "node tools/preview.mjs --dev",
    "test:dev": "node tools/runtime-performance.mjs --dev",
    "build:assets": "node tools/build.mjs --assets",
    "analyze:package": "node tools/package-report.mjs",
    "analyze:code": "node tools/build.mjs --analyze",
    "layout": "node tools/layout-reference.mjs",
    "test": "node --test source/tools/lite.test.mjs tools/range.test.mjs tools/styles.test.mjs tools/layout.test.mjs tools/ui-cache.test.mjs tools/paper.test.mjs tools/loading.test.mjs tools/surfaces.test.mjs tools/performance.test.mjs tools/optimization.test.mjs tools/experience.test.mjs tools/runtime-data.test.mjs tools/characters.test.mjs tools/starter-characters.test.mjs",
    "test:map-play": "node --test tools/workshop-marbles.test.mjs && node tools/runtime-performance.mjs --map-play",
    "test:ui-perf": "node tools/smoke.mjs --phone-layout --software-render --ui-perf",
    "test:performance": "node tools/runtime-performance.mjs",
    "test:optimizations": "node tools/runtime-performance.mjs --optimize",
    "test:loading": "node tools/smoke.mjs --phone-layout --software-render --loading-perf",
    "test:boot": "node tools/boot-loading-regression.mjs",
    "test:upgrade": "node tools/smoke.mjs --phone-layout --software-render --upgrade-perf",
    "test:scenes": "node tools/smoke.mjs --phone-layout --software-render --scene-regression",
    "verify:assets": "node tools/verify-assets.mjs",
    "verify:source": "node tools/verify-source.mjs",
    "test:touch": "node tools/smoke.mjs --phone-layout --forest-regression",
    "test:paper": "node tools/smoke.mjs --phone-layout --software-render --paper-art",
    "test:menus": "node tools/smoke.mjs --menus-only",
    "test:characters": "node tools/smoke.mjs --phone-layout --software-render --starter-regression",
    "test:wind": "node --test tools/wind-animation.test.mjs && node tools/runtime-performance.mjs --wind-animation",
    "test:vfx": "node tools/runtime-performance.mjs --vfx",
    "test:ink": "node tools/runtime-performance.mjs --vfx --ink-style",
    "test:lighting": "node tools/runtime-performance.mjs --vfx --lighting",
    "test:fire": "node tools/runtime-performance.mjs --vfx --fire-breath"
  }
}
