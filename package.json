{
  "name": "pokebonk-wechat-portrait",
  "version": "0.8.34-portrait.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:dev": "node tools/build.mjs --dev",
    "preview": "node tools/preview.mjs",
    "preview:dev": "node tools/preview.mjs --dev",
    "test:dev": "node tools/runtime-performance.mjs --dev",
    "build:assets": "node tools/build.mjs --assets",
    "analyze:package": "node tools/package-report.mjs",
    "analyze:code": "node tools/build.mjs --analyze",
    "layout": "node tools/layout-reference.mjs",
    "test": "node --test source/tools/lite.test.mjs tools/tests/cloud-progress.test.mjs tools/tests/cloud-coop.test.mjs tools/tests/peer-motion.test.mjs tools/tests/range.test.mjs tools/tests/styles.test.mjs tools/tests/layout.test.mjs tools/tests/ui-cache.test.mjs tools/tests/paper.test.mjs tools/tests/loading.test.mjs tools/tests/surfaces.test.mjs tools/tests/performance.test.mjs tools/tests/optimization.test.mjs tools/tests/experience.test.mjs tools/tests/runtime-data.test.mjs tools/tests/characters.test.mjs tools/tests/starter-characters.test.mjs tools/tests/audio.test.mjs tools/tests/device-performance.test.mjs tools/tests/portal-screen.test.mjs tools/tests/frame-policy.test.mjs tools/tests/skill-availability.test.mjs",
    "test:frame-stability": "node tools/runtime-performance.mjs --android-performance --frame-stability && node tools/runtime-performance.mjs --ios-budget --frame-stability",
    "test:boss-performance": "node tools/runtime-performance.mjs --android-performance --boss-performance",
    "test:summon": "node tools/runtime-performance.mjs --summon-mode",
    "test:android-performance": "node tools/runtime-performance.mjs --android-performance --startup-soak",
    "test:android-stability": "node tools/runtime-performance.mjs --android-performance --android-stability --stability-probes",
    "build:portal-screen": "node tools/art/portal-screen-atlas.mjs",
    "test:map-play": "node --test tools/tests/workshop-marbles.test.mjs && node tools/runtime-performance.mjs --map-play",
    "test:desk-navigation": "node --test tools/tests/desk-navigation.test.mjs && node tools/smoke.mjs --phone-layout --software-render --desk2d --desk-navigation-only",
    "test:ui-perf": "node tools/smoke.mjs --phone-layout --software-render --ui-perf",
    "test:performance": "node tools/runtime-performance.mjs",
    "test:optimizations": "node tools/runtime-performance.mjs --optimize",
    "test:loading": "node tools/smoke.mjs --phone-layout --software-render --loading-perf",
    "test:boot": "node tools/regression/boot-loading-regression.mjs",
    "test:startup": "node tools/smoke.mjs --phone-layout --software-render --startup-latency",
    "test:upgrade": "node tools/smoke.mjs --phone-layout --software-render --upgrade-perf",
    "test:upgrade-effects": "node --test tools/tests/evolution-timing.test.mjs && node tools/runtime-performance.mjs --upgrade-effects",
    "test:scenes": "node tools/smoke.mjs --phone-layout --software-render --scene-regression",
    "test:devices": "node tools/smoke.mjs --phone-layout --software-render --device-effects",
    "verify:assets": "node tools/verify-assets.mjs",
    "verify:source": "node tools/verify-source.mjs",
    "test:touch": "node tools/smoke.mjs --phone-layout --forest-regression",
    "test:joystick": "node tools/smoke.mjs --phone-layout --software-render --joystick-only",
    "test:paper": "node tools/smoke.mjs --phone-layout --software-render --paper-art",
    "test:menus": "node tools/smoke.mjs --menus-only",
    "test:characters": "node tools/smoke.mjs --phone-layout --software-render --starter-regression",
    "test:wind-skills": "node --test tools/tests/skill-availability.test.mjs tools/tests/wind-frame-time.test.mjs && node tools/runtime-performance.mjs --vfx --wind-skills",
    "test:wind": "node --test tools/tests/wind-animation.test.mjs && node tools/runtime-performance.mjs --wind-animation",
    "test:vfx": "node tools/runtime-performance.mjs --vfx",
    "test:ink": "node tools/runtime-performance.mjs --vfx --ink-style",
    "test:lighting": "node tools/runtime-performance.mjs --vfx --lighting",
    "test:fire": "node tools/runtime-performance.mjs --vfx --fire-breath",
    "test:fire-skills": "node tools/runtime-performance.mjs --vfx --fire-family && node tools/runtime-performance.mjs --vfx --fire-fusions && node tools/runtime-performance.mjs --vfx --fire-completion && node tools/runtime-performance.mjs --vfx --fire-family-media",
    "test:skills": "node --test tools/tests/skill-availability.test.mjs && node tools/runtime-performance.mjs --vfx --skill-availability"
  }
}
